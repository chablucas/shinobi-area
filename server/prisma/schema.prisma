generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id                Int        @id @default(autoincrement())
  name              String
  slug              String     @unique
  imageUrl          String?
  cloudinaryPublicId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  stats             CardStat[]
  savedBuildSlots   SavedBuildSlot[]
}

model User {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  passwordHash String
  displayName String
  wins        Int         @default(0)
  losses      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  role        UserRole    @default(USER)
  savedBuilds SavedBuild[]
  gameResults GameResult[]
  friendshipsAsA Friendship[] @relation("FriendshipUserA")
  friendshipsAsB Friendship[] @relation("FriendshipUserB")
  sentFriendships Friendship[] @relation("FriendshipSender")
  receivedFriendships Friendship[] @relation("FriendshipReceiver")
  createdGameLobbies GameLobby[] @relation("GameLobbyCreator")
  gameInvites       GameInvite[] @relation("GameInviteInvitee")
}

enum UserRole {
  USER
  ADMIN
}

enum CardModifierDirection {
  BONUS
  MALUS
}

enum CardModifierOperation {
  PERCENT
  POINTS
}

enum CardModifierTarget {
  chakra
  invocation
  iq
  ninjutsuAttack
  ninjutsuDefense
  genjutsu
  taijutsu
  avatar
  body
  fuinjutsu
  senjutsu
  kenjutsu
  speed
  kekkeiGenkai
  kekkeiMora
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum GameMode {
  ONE_V_ONE
  ONE_V_ONE_V_THREE
}

enum GameInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum GameLobbyStatus {
  WAITING
  READY
  PLAYING
}

model GameLobby {
  id        String          @id @default(cuid())
  mode      GameMode
  creatorId Int
  status    GameLobbyStatus @default(WAITING)
  includesAi Boolean        @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  creator   User            @relation("GameLobbyCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  invites   GameInvite[]
  game      Game?

  @@index([creatorId, status])
}

enum GameStatus {
  PLAYING
  AWAITING_RESULT
  FINISHED
}

model Game {
  id                 String     @id @default(cuid())
  lobbyId            String     @unique
  mode               GameMode
  status             GameStatus @default(PLAYING)
  currentPlayerNumber Int       @default(1)
  turnNumber         Int        @default(1)
  state              Json
  winnerNumber       Int?
  createdAt          DateTime   @default(now())
  startedAt          DateTime   @default(now())
  finishedAt         DateTime?
  lobby              GameLobby  @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@index([status])
}

model GameInvite {
  id        String           @id @default(cuid())
  lobbyId   String
  inviteeId Int
  status    GameInviteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lobby     GameLobby        @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  invitee   User             @relation("GameInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, inviteeId])
  @@index([inviteeId, status])
}

model Friendship {
  id         Int              @id @default(autoincrement())
  userAId    Int
  userBId    Int
  senderId   Int
  receiverId Int
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userA      User             @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB      User             @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)
  sender     User             @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model GameResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    String
  won       Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model SavedBuild {
  id        Int              @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots     SavedBuildSlot[]
}

model SavedBuildSlot {
  id           Int        @id @default(autoincrement())
  savedBuildId Int
  categorySlug String
  cardId       Int
  savedBuild   SavedBuild @relation(fields: [savedBuildId], references: [id], onDelete: Cascade)
  card         Card       @relation(fields: [cardId], references: [id])

  @@unique([savedBuildId, categorySlug])
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String     @unique
  position Int
  stats    CardStat[]
}

model CardStat {
  id         Int      @id @default(autoincrement())
  cardId     Int
  categoryId Int
  value      Int?
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cardId, categoryId])
}

model CardStatOverride {
  id        Int      @id @default(autoincrement())
  cardSlug  String
  statKey   String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cardSlug, statKey])
  @@index([cardSlug])
}

model CardRarityOverride {
  id        Int      @id @default(autoincrement())
  cardSlug  String   @unique
  rarity    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardModifier {
  id            Int                     @id @default(autoincrement())
  cardSlug      String
  name          String
  description   String
  target        CardModifierTarget
  categories    String[]                @default([])
  direction     CardModifierDirection
  operation     CardModifierOperation
  value         Int
  condition     String?
  conditionType String?
  conditionValue String?
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  @@index([cardSlug])
}